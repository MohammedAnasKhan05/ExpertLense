# ==============================================================================
# ExpertLens AI — Environment Configuration Template
# Copy this file to .env and configure your secrets & settings:
#   cp .env.example .env
# ==============================================================================

# Application
APP_NAME="ExpertLens AI"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT="development"

# Server & Networking
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# LLM Provider Configuration
# Supported options: "groq", "huggingface", "local"
LLM_PROVIDER=groq

# ------------------------------------------------------------------------------
# Groq Cloud API (https://console.groq.com)
# Recommended models:
#   - llama-3.3-70b-versatile
#   - llama-3.1-8b-instant
#   - mixtral-8x7b-32768
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Hugging Face Inference API (https://huggingface.co/settings/tokens)
# Recommended models:
#   - mistralai/Mistral-7B-Instruct-v0.3
#   - meta-llama/Meta-Llama-3-8B-Instruct
# ------------------------------------------------------------------------------
HF_TOKEN=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ------------------------------------------------------------------------------
# Database Configuration
# Default: SQLite (development)
# Production PostgreSQL example: postgresql+asyncpg://user:pass@localhost:5432/expertlens
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./expertlens.db

# ------------------------------------------------------------------------------
# Vector Store / ChromaDB & Embeddings
# ------------------------------------------------------------------------------
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=transcript_chunks
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# Retrieval & Analysis Thresholds
# ------------------------------------------------------------------------------
RETRIEVAL_TOP_K=10
RETRIEVAL_SCORE_THRESHOLD=0.3
QUOTE_SIMILARITY_THRESHOLD=0.75

# ------------------------------------------------------------------------------
# Evaluation & Regression Release Gates
# ------------------------------------------------------------------------------
EVAL_MIN_ACCURACY=0.85
EVAL_MIN_GROUNDEDNESS=0.90
EVAL_MAX_HALLUCINATION=0.05
EVAL_MIN_CITATION_COVERAGE=0.85

# ------------------------------------------------------------------------------
# Frontend Settings
# ------------------------------------------------------------------------------
VITE_API_BASE=http://localhost:8000
